{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/crm-worker",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/crm-cases-sync",
      "schedule": "15,45 * * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/crm-backfill",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/crm-gmail-filtered",
      "schedule": "7-59/10 * * * *"
    },
    {
      "path": "/api/crm-gmail-stage",
      "schedule": "3-59/10 * * * *"
    },
    {
      "path": "/api/crm-orders-stage",
      "schedule": "5-59/10 * * * *"
    },
    {
      "path": "/api/crm-orders-reconcile",
      "schedule": "9-59/10 * * * *"
    },
    {
      "path": "/api/crm-milestones",
      "schedule": "6-59/10 * * * *"
    }
  ]
}
