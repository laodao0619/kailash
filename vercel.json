{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/crm-worker",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/crm-cases-sync",
      "schedule": "15,45 * * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/crm-daily-customers",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/crm-daily-orders",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/crm-daily-gmail",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/crm-daily-customers",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/crm-daily-gmail",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/crm-daily-orders",
      "schedule": "10 14 * * *"
    },
    {
      "path": "/api/crm-gmail-filtered",
      "schedule": "*/10 * * * *"
    }
  ]
}
