{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/crm-worker",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 8 * * *"
    }
  ]
}
