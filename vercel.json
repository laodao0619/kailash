{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/crm-worker",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/crm-cases-sync",
      "schedule": "15,45 * * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/crm-reminders",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/crm-gmail-filtered",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/crm-daily-customers",
      "schedule": "50 0 * * *"
    },
    {
      "path": "/api/crm-daily-orders",
      "schedule": "55 0 * * *"
    },
    {
      "path": "/api/crm-daily-gmail",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/crm-daily-customers",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/crm-daily-orders",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/crm-daily-gmail",
      "schedule": "25 5 * * *"
    },
    {
      "path": "/api/crm-daily-customers",
      "schedule": "45 7 * * *"
    },
    {
      "path": "/api/crm-daily-orders",
      "schedule": "50 7 * * *"
    },
    {
      "path": "/api/crm-daily-gmail",
      "schedule": "55 7 * * *"
    },
    {
      "path": "/api/bi-index-build",
      "schedule": "*/5 * * * *"
    }
  ]
}
